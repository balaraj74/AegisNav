Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /Hazard Now (estimate)1
        - /Risk-aware Path1
      Splitter Ratio: 0.55
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Name: Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Hazard Now (estimate)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aegisnav/hazard_markers/current
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Hazard Predicted (+10 s)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aegisnav/hazard_markers/predicted
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Mission (base, refuges, goal, decision)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aegisnav/mission_markers
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Risk-aware Path
      Color: 0; 200; 255
      Line Style: Billboards
      Line Width: 0.06
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /aegisnav/planned_path
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Simulated Lidar
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Size (m): 0.04
      Style: Flat Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /scan
      Value: true
    - Class: rviz_default_plugins/Polygon
      Name: Robot footprint
      Color: 255; 140; 0
      Alpha: 1
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Arrows: false
      Show Names: false
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        base_footprint:
          Value: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 25; 28; 34
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 13
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Pitch: 1.2
      Yaw: 4.71
      Value: Orbit (rviz)
Window Geometry:
  Height: 900
  Width: 1400
