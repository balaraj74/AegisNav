<?xml version="1.0"?>
<package format="3">
  <name>aegisnav_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 adapters for AegisNav hazard forecasting, mission assessment and risk-aware path publication.</description>
  <maintainer email="maintainer@example.invalid">AegisNav Maintainers</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>aegisnav_core</exec_depend>
  <exec_depend>aegisnav_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
